#!/bin/sh
# 静态门禁：提交前强制执行 verify.py 的 STATIC 层（可编译/版本联动/算法同源/数据可解析，秒级）。
# 完整三层验证（python tools/verify.py）仍是提交前的流程要求，见 PROJECT.md §3/§4。
# 临时绕过：git commit --no-verify
if ! command -v python >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 python，本次跳过静态门禁（请确认 python 在 PATH 中）" >&2
  exit 0
fi
python tools/verify.py --static || {
  echo "" >&2
  echo "[pre-commit] 静态门禁未通过：修复上方 FAIL 项后重试，或 git commit --no-verify 临时绕过" >&2
  exit 1
}
